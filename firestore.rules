rules_version = '2';

// O site inteiro exige login com a conta Google institucional da escola
// (domínio @edu.joinville.sc.gov.br) — sem essa verificação nenhuma leitura
// ou escrita é permitida. Por cima disso, "gestores" e "bloqueios" exigem a
// claim `gestor: true` (função `autenticarGestor` em functions/index.js),
// pra ações administrativas.
//
// reservas e professores também exigem que o e-mail do documento bata com o
// e-mail de quem está logado — assim ninguém agenda ou edita o cadastro em
// nome de outro professor. O gestor pode mexer em qualquer um dos dois.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@edu[.]joinville[.]sc[.]gov[.]br$');
    }

    function ehGestor() {
      return autenticado() && request.auth.token.gestor == true;
    }

    function ehDono(email) {
      return autenticado() && request.auth.token.email == email;
    }

    match /professores/{id} {
      allow read: if autenticado();
      allow create: if ehDono(request.resource.data.email) || ehGestor();
      allow update, delete: if ehDono(resource.data.email) || ehGestor();
    }

    match /gestores/{id} {
      allow read: if autenticado();
      allow write: if ehGestor();
    }

    match /reservas/{id} {
      allow read: if autenticado();
      allow create: if ehDono(request.resource.data.professorEmail) || ehGestor();
      allow update, delete: if ehDono(resource.data.professorEmail) || ehGestor();
    }

    match /bloqueios/{id} {
      allow read: if autenticado();
      allow write: if ehGestor();
    }
  }
}
