rules_version = '2';

// O site inteiro agora exige login (claim `acesso: true`, obtida via o
// portão de entrada — função `autenticarAcesso` em functions/index.js).
// Por cima disso, `gestores` e `bloqueios` exigem a claim `gestor: true`
// (função `autenticarGestor`), pra ações administrativas. Nenhum dos dois
// códigos fica exposto no navegador — só o servidor os conhece.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null && request.auth.token.acesso == true;
    }

    function ehGestor() {
      return request.auth != null && request.auth.token.gestor == true;
    }

    match /professores/{id} {
      allow read, write: if autenticado();
    }

    match /gestores/{id} {
      allow read: if autenticado();
      allow write: if ehGestor();
    }

    match /reservas/{id} {
      allow read, create: if autenticado();
      // Cancelamento (próprio ou pelo gestor) só exige estar logado — não
      // há identidade de professor individual pra diferenciar os dois casos.
      allow update, delete: if autenticado();
    }

    match /bloqueios/{id} {
      allow read: if autenticado();
      allow write: if ehGestor();
    }
  }
}
