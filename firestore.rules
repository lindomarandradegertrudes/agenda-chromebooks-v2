rules_version = '2';

// Nível de proteção mínimo (ver PROJECT_SPEC.md — "Opção mínima"):
// - gestores e bloqueios exigem a claim `gestor: true`, obtida via login com
//   custom token depois de validar o código no servidor (função
//   `autenticarGestor` em functions/index.js) — o código nunca fica exposto
//   no navegador, diferente do antigo VITE_GESTOR_CODE.
// - professores (ler/criar) e reservas (criar/cancelar) continuam abertos,
//   já que são ações que qualquer professor precisa fazer o tempo todo e
//   não há autenticação de professor implementada.
service cloud.firestore {
  match /databases/{database}/documents {

    function ehGestor() {
      return request.auth != null && request.auth.token.gestor == true;
    }

    match /professores/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /gestores/{id} {
      allow read: if true;
      allow write: if ehGestor();
    }

    match /reservas/{id} {
      allow read: if true;
      allow create: if true;
      // Cancelamento (próprio ou pelo gestor) continua sem exigir login —
      // não há identidade de professor autenticada para diferenciar os dois casos.
      allow update, delete: if true;
    }

    match /bloqueios/{id} {
      allow read: if true;
      allow write: if ehGestor();
    }
  }
}
